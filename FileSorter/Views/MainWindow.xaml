<Window x:Class="FileSorter.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FileSorter.ViewModels;assembly=FileSorter.Core"
        xmlns:conv="clr-namespace:FileSorter.Converters"
        xmlns:controls="clr-namespace:FileSorter.Controls"
        xmlns:models="clr-namespace:FileSorter.Models;assembly=FileSorter.Core"
        Title="FileSorter - Easy File Organizer"
        Icon="pack://application:,,,/app.ico"
        Width="1200" Height="750"
        MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource PrimaryBackgroundBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:BoolToIndexConverter x:Key="BoolToIndex" />
        <conv:OrganizeMethodToStringConverter x:Key="MethodToString" />
        <conv:BoolToFolderIconConverter x:Key="BoolToFolderIcon" />
        <conv:BoolToFontWeightConverter x:Key="BoolToFontWeight" />
        <conv:BoolToColorConverter x:Key="BoolToColor" />
        <conv:ColorToBrushConverter x:Key="ColorToBrush" />
        <conv:MethodMatchConverter x:Key="MethodMatch" />
        <conv:TimestampToRelativeConverter x:Key="TimestampToRelative" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== TOP BAR (draggable) ==================== -->
        <Border Grid.Row="0" Background="{StaticResource AccentBrush}" Padding="0,14"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="Easy File Organizer"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="White" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <!-- Window control buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,-6,4,0">
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding ToggleThemeCommand}"
                            Content="&#xE706;" FontFamily="Segoe MDL2 Assets"
                            FontSize="12" Foreground="White" Padding="10,6"
                            ToolTip="Toggle Theme" />
                    <Button Style="{StaticResource IconButton}"
                            Click="MinimizeButton_Click"
                            Content="&#xE949;" FontFamily="Segoe MDL2 Assets"
                            FontSize="10" Foreground="White" Padding="10,6"
                            ToolTip="Minimize" />
                    <Button Style="{StaticResource IconButton}"
                            Click="MaximizeButton_Click"
                            Content="&#xE739;" FontFamily="Segoe MDL2 Assets"
                            FontSize="10" Foreground="White" Padding="10,6"
                            ToolTip="Maximize" />
                    <Button Click="CloseButton_Click"
                            Content="&#xE106;" FontFamily="Segoe MDL2 Assets"
                            FontSize="10" Foreground="White" Padding="10,6"
                            ToolTip="Close">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <SolidColorBrush Color="#E81123" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MAIN 3-COLUMN LAYOUT ==================== -->
        <Grid Grid.Row="1" Margin="12,12,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftPanelColumn" Width="310" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightPanelColumn" Width="300" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- Left splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent"
                          Cursor="SizeWE" />

            <!-- Right splitter -->
            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent"
                          Cursor="SizeWE" />

            <!-- ========== LEFT PANEL: FOLDERS + RULES ========== -->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ===== TOP HALF: FOLDERS ===== -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Add Folder Button -->
                            <Button Style="{StaticResource SecondaryButton}"
                                    Command="{Binding AddFolderCommand}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="14" VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <TextBlock Text="ADD FOLDER" FontFamily="Segoe UI"
                                               FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Folders (each has its own profile; removed only manually) -->
                            <TextBlock Text="Folders"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Margin="0,0,0,6" />

                            <ItemsControl ItemsSource="{Binding Folders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="row"
                                                CornerRadius="6" Padding="10,6" Margin="0,0,0,2"
                                                Cursor="Hand"
                                                ToolTip="{Binding FullPath}">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.SelectFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}" />
                                            </Border.InputBindings>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource TertiaryBackgroundBrush}" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource TertiaryBackgroundBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Checked folders are organized together, each with its own profile -->
                                                <CheckBox Grid.Column="0"
                                                          Style="{StaticResource ModernCheckBox}"
                                                          IsChecked="{Binding IsChecked}"
                                                          IsEnabled="{Binding DataContext.IsOrganizing, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBool}}"
                                                          VerticalAlignment="Center" Margin="0,0,6,0"
                                                          ToolTip="Include in multi-folder organize" />
                                                <TextBlock Grid.Column="1"
                                                           Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="14"
                                                           VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Name}"
                                                           FontSize="13"
                                                           Foreground="{StaticResource PrimaryTextBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontWeight" Value="Normal" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <!-- Auto-organize indicator: green = on, yellow = paused, none = off -->
                                                <Ellipse Grid.Column="3" Width="7" Height="7"
                                                         VerticalAlignment="Center" Margin="6,0,0,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AutoStatus}" Value="On">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                                    <Setter Property="ToolTip" Value="Auto-organize on" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding AutoStatus}" Value="Paused">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                                                    <Setter Property="ToolTip" Value="Auto-organize paused" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding FileCount}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0" />
                                                <Button Grid.Column="5"
                                                        Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Content="&#xE711;"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        FontSize="10" Padding="4"
                                                        Margin="4,0,0,0"
                                                        ToolTip="Remove from list">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                            <Setter Property="Visibility" Value="Hidden" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=row}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="No folders yet"
                                       Foreground="{StaticResource BorderBrush}"
                                       FontSize="11" FontStyle="Italic"
                                       Margin="4,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Folders.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ===== AUTO-ORGANIZE (selected folder) + global options ===== -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,8">
                    <StackPanel>
                        <Grid Visibility="{Binding HasSourceFolder, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Auto-organize"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="12" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       ToolTip="Organize this folder's root automatically with its current settings" />
                            <CheckBox Style="{StaticResource ModernCheckBox}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      IsChecked="{Binding AutoEnabled}"
                                      ToolTip="Auto-organize this folder with its current settings" />
                        </Grid>

                        <StackPanel Visibility="{Binding AutoEnabled, Converter={StaticResource BoolToVis}}"
                                    Margin="0,6,0,0">
                            <CheckBox Style="{StaticResource ModernCheckBox}"
                                      Content="On new files" FontSize="12"
                                      IsChecked="{Binding AutoOnNewFiles}"
                                      Margin="0,0,0,6"
                                      ToolTip="Organize new files about 30 seconds after they stop changing" />

                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Style="{StaticResource ModernCheckBox}"
                                          Content="Every" FontSize="12"
                                          IsChecked="{Binding AutoScheduleEnabled}"
                                          VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding AutoScheduleInterval}"
                                         IsEnabled="{Binding AutoScheduleEnabled}"
                                         FontSize="12" Padding="4,3"
                                         Background="{StaticResource SecondaryBackgroundBrush}"
                                         Foreground="{StaticResource PrimaryTextBrush}"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         BorderThickness="1"
                                         Margin="0,0,6,0" />
                                <ComboBox Grid.Column="2" FontSize="12" Padding="6,3"
                                          IsEnabled="{Binding AutoScheduleEnabled}"
                                          SelectedValuePath="Tag"
                                          SelectedValue="{Binding AutoScheduleUnit}">
                                    <ComboBoxItem Content="Minutes" Tag="{x:Static models:ScheduleUnit.Minutes}" />
                                    <ComboBoxItem Content="Hours" Tag="{x:Static models:ScheduleUnit.Hours}" />
                                    <ComboBoxItem Content="Days" Tag="{x:Static models:ScheduleUnit.Days}" />
                                </ComboBox>
                            </Grid>

                            <!-- Undoing one of the folder's operations pauses it -->
                            <Grid Margin="0,6,0,0"
                                  Visibility="{Binding AutoIsPaused, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Paused (an operation was undone)"
                                           Foreground="{StaticResource WarningBrush}"
                                           FontSize="12" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,64,0" />
                                <Button Style="{StaticResource SecondaryButton}"
                                        Command="{Binding ResumeAutoCommand}"
                                        HorizontalAlignment="Right" Padding="8,3">
                                    <TextBlock Text="Resume" FontFamily="Segoe UI" FontSize="11" />
                                </Button>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding AutoWarnings}" Margin="0,6,0,0"
                                          Visibility="{Binding HasAutoWarnings, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   Foreground="{StaticResource WarningBrush}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Margin="0,0,0,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Global pause (also in the tray menu) -->
                        <Grid Margin="0,6,0,0"
                              Visibility="{Binding PauseAll, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="All auto-organize paused"
                                       Foreground="{StaticResource WarningBrush}"
                                       FontSize="12" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,80,0" />
                            <Button Style="{StaticResource SecondaryButton}"
                                    Command="{Binding TogglePauseAllCommand}"
                                    HorizontalAlignment="Right" Padding="8,3">
                                <TextBlock Text="Resume all" FontFamily="Segoe UI" FontSize="11" />
                            </Button>
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8,0,6" />

                        <CheckBox Style="{StaticResource ModernCheckBox}"
                                  Content="Start with Windows" FontSize="12"
                                  IsChecked="{Binding StartWithWindows}"
                                  ToolTip="Start FileSorter in the tray when you sign in" />
                    </StackPanel>
                </Border>

                <!-- ===== BOTTOM HALF: RULES ===== -->
                <Border Grid.Row="3" Style="{StaticResource Card}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Routing rules: checked top to bottom, the first match wins -->
                            <TextBlock Text="Rules"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Margin="0,0,0,6"
                                       ToolTip="Checked top to bottom; the first matching rule decides where a file goes" />

                            <ItemsControl ItemsSource="{Binding Rules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Accent stripe on the left marks where each rule starts and ends -->
                                        <Border Background="{StaticResource TertiaryBackgroundBrush}"
                                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="3,0,0,0"
                                                CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                            <StackPanel>
                                                <!-- On/off, order, remove -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0"
                                                              Style="{StaticResource ModernCheckBox}"
                                                              IsChecked="{Binding IsEnabled}"
                                                              VerticalAlignment="Center"
                                                              ToolTip="Rule enabled" />

                                                    <TextBlock Grid.Column="1" Text="Rule"
                                                               Foreground="{StaticResource PrimaryTextBrush}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" Margin="2,0,0,0" />

                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource IconButton}"
                                                            Command="{Binding DataContext.MoveRuleUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="&#xE74A;"
                                                            FontSize="11" Padding="4"
                                                            ToolTip="Move up" />

                                                    <Button Grid.Column="3"
                                                            Style="{StaticResource IconButton}"
                                                            Command="{Binding DataContext.MoveRuleDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="&#xE74B;"
                                                            FontSize="11" Padding="4"
                                                            ToolTip="Move down" />

                                                    <Button Grid.Column="4"
                                                            Style="{StaticResource IconButton}"
                                                            Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Content="&#xE711;"
                                                            FontSize="11" Padding="4"
                                                            ToolTip="Remove rule" />
                                                </Grid>
                                                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,8" />

                                                <!-- All / Any (the pair is grouped by its own panel) -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="Match"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               FontSize="12" VerticalAlignment="Center"
                                                               Margin="0,0,8,0" />
                                                    <RadioButton Content="All"
                                                                 IsChecked="{Binding MatchAll}"
                                                                 Foreground="{StaticResource PrimaryTextBrush}"
                                                                 FontSize="12" VerticalAlignment="Center"
                                                                 Margin="0,0,10,0" />
                                                    <RadioButton Content="Any"
                                                                 IsChecked="{Binding MatchAny}"
                                                                 Foreground="{StaticResource PrimaryTextBrush}"
                                                                 FontSize="12" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Conditions -->
                                                <ItemsControl ItemsSource="{Binding Conditions}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,4">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <ComboBox Grid.Column="0"
                                                                          ItemsSource="{Binding AvailableFields}"
                                                                          SelectedItem="{Binding Field}"
                                                                          FontSize="11" Padding="4,3"
                                                                          Margin="0,0,4,0"
                                                                          MinWidth="75" />

                                                                <ComboBox Grid.Column="1"
                                                                          ItemsSource="{Binding AvailableOperators}"
                                                                          SelectedItem="{Binding Operator}"
                                                                          FontSize="11" Padding="4,3"
                                                                          Margin="0,0,4,0"
                                                                          MinWidth="75" />

                                                                <TextBox Grid.Column="2"
                                                                         Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                                         FontSize="12" Padding="6,4"
                                                                         Background="{StaticResource SecondaryBackgroundBrush}"
                                                                         Foreground="{StaticResource PrimaryTextBrush}"
                                                                         BorderBrush="{StaticResource BorderBrush}"
                                                                         BorderThickness="1"
                                                                         Margin="0,0,4,0" />

                                                                <Button Grid.Column="3"
                                                                        Style="{StaticResource IconButton}"
                                                                        Command="{Binding RemoveCommand}"
                                                                        Content="&#xE711;"
                                                                        FontFamily="Segoe MDL2 Assets"
                                                                        FontSize="11" Padding="4"
                                                                        ToolTip="Remove condition" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <Button Style="{StaticResource SecondaryButton}"
                                                            Command="{Binding AddConditionCommand}"
                                                            Padding="8,3">
                                                        <TextBlock Text="+ condition" FontFamily="Segoe UI" FontSize="11" />
                                                    </Button>
                                                    <!-- Without a folder, matching files go to the destination folder itself -->
                                                    <Button Style="{StaticResource SecondaryButton}"
                                                            Command="{Binding AddFolderCommand}"
                                                            Padding="8,3" Margin="6,0,0,0"
                                                            Visibility="{Binding HasFolder, Converter={StaticResource InvBoolToVis}}"
                                                            ToolTip="Send matching files to their own folder; without one they are organized like the others (method or template)">
                                                        <TextBlock Text="+ folder" FontFamily="Segoe UI" FontSize="11" />
                                                    </Button>
                                                </StackPanel>

                                                <!-- Arrow: files matching the conditions go to the destination below -->
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,4"
                                                            Visibility="{Binding HasFolder, Converter={StaticResource BoolToVis}}">
                                                    <Path Data="M 8,1 L 8,19 M 2,13 L 8,19 L 14,13"
                                                          Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          Width="16" Height="20" VerticalAlignment="Center" />
                                                    <TextBlock Text="matching files go to"
                                                               Foreground="{StaticResource SecondaryTextBrush}"
                                                               FontSize="11" FontStyle="Italic"
                                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                                </StackPanel>

                                                <!-- Destination of the rule -->
                                                <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                                        CornerRadius="4" Background="{StaticResource SecondaryBackgroundBrush}"
                                                        Padding="6,2,2,2"
                                                        Visibility="{Binding HasFolder, Converter={StaticResource BoolToVis}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="&#xE8B7;"
                                                                   FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                                   Foreground="{StaticResource AccentBrush}"
                                                                   VerticalAlignment="Center" Margin="0,0,6,0" />

                                                        <TextBox x:Name="RuleDestination" Grid.Column="1"
                                                                 Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}"
                                                                 FontSize="12" Padding="2,4"
                                                                 Background="Transparent"
                                                                 Foreground="{StaticResource PrimaryTextBrush}"
                                                                 CaretBrush="{StaticResource PrimaryTextBrush}"
                                                                 BorderThickness="0"
                                                                 VerticalContentAlignment="Center"
                                                                 ToolTip="A name (Movies) is a subfolder of the destination folder, a full path (D:\Video) is used as is. Empty: matching files are organized like the others (method or template)." />

                                                        <!-- Placeholder while the destination is empty -->
                                                        <TextBlock Grid.Column="1" Text="Subfolder name or full path"
                                                                   IsHitTestVisible="False"
                                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                                   FontSize="12" Opacity="0.7"
                                                                   VerticalAlignment="Center" Margin="4,0,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Text, ElementName=RuleDestination}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>

                                                        <Button Grid.Column="2"
                                                                Style="{StaticResource IconButton}"
                                                                Command="{Binding DataContext.BrowseRuleDestinationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Content="&#xE712;"
                                                                FontSize="11" Padding="6,4"
                                                                ToolTip="Browse for destination folder" />

                                                        <Button Grid.Column="3"
                                                                Style="{StaticResource IconButton}"
                                                                Command="{Binding RemoveFolderCommand}"
                                                                Content="&#xE711;"
                                                                FontSize="11" Padding="6,4"
                                                                ToolTip="Remove folder: matching files are organized like the others (method or template)" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Add Rule Button -->
                            <Button Style="{StaticResource SecondaryButton}"
                                    Command="{Binding AddRuleCommand}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="+" FontSize="16" FontWeight="Bold"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="Add Rule" FontFamily="Segoe UI"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Files no rule matched -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Other files:"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12" VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <ComboBox Grid.Column="1" FontSize="12" Padding="6,4"
                                          SelectedValuePath="Tag"
                                          SelectedValue="{Binding Unmatched}"
                                          ToolTip="What happens to files that no rule matched">
                                    <ComboBoxItem Content="Organize normally"
                                                  Tag="{x:Static models:UnmatchedFilesMode.OrganizeNormally}" />
                                    <ComboBoxItem Content="Leave in place"
                                                  Tag="{x:Static models:UnmatchedFilesMode.LeaveInPlace}" />
                                </ComboBox>
                            </Grid>

                            <!-- Separator -->
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,10,0,10" />

                            <!-- Destination of this folder: copy/move, target folder, subfolder template -->
                            <TextBlock Text="Destination"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Margin="0,0,0,2" />
                            <TextBlock Text="For all files of this folder; short rule folders go inside it"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="11" FontStyle="Italic" Opacity="0.8"
                                       TextWrapping="Wrap" Margin="0,0,0,8" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Files"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12" VerticalAlignment="Center"
                                           Margin="0,0,10,6" />

                                <ComboBox Grid.Row="0" Grid.Column="1" FontSize="12" Padding="6,4"
                                          Margin="0,0,6,6" MinWidth="80"
                                          SelectedIndex="{Binding CopyMode, Converter={StaticResource BoolToIndex}}"
                                          ToolTip="Move or copy files (rules included)">
                                    <ComboBoxItem Content="Move to" />
                                    <ComboBoxItem Content="Copy to" />
                                </ComboBox>

                                <Button Grid.Row="0" Grid.Column="2"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding SelectDestinationCommand}"
                                        HorizontalAlignment="Left"
                                        Padding="8,4" Margin="0,0,0,6"
                                        ToolTip="{Binding DestinationFolder}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8B7;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   Margin="0,0,4,0" Foreground="{StaticResource WarningBrush}" />
                                        <TextBlock Text="{Binding DestinationDisplay}"
                                                   FontFamily="Segoe UI"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Subfolders"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12" VerticalAlignment="Center"
                                           Margin="0,0,10,0" />

                                <TextBox x:Name="SubfolderTemplate" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                         Text="{Binding DestinationSubfolderPattern, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12" Padding="6,4"
                                         Background="{StaticResource SecondaryBackgroundBrush}"
                                         Foreground="{StaticResource PrimaryTextBrush}"
                                         CaretBrush="{StaticResource PrimaryTextBrush}"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         BorderThickness="1"
                                         ToolTip="Template for files no rule matched: #type #ext #year #month #date #datetaken #alpha #size #prefix (e.g. #type/#ext). Overrides the method buttons." />

                                <!-- Placeholder while the template is empty -->
                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                           Text="By method above, or a template like #type/#ext"
                                           IsHitTestVisible="False"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           FontSize="12" Opacity="0.7"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="9,0,4,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=SubfolderTemplate}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ========== CENTER PANEL: CHART + CONTROLS ========== -->
            <Grid Grid.Column="2" Margin="4,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>

                <!-- Method Tabs -->
                <Border Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Type" Margin="2,0"
                                Command="{Binding SetMethodCommand}"
                                CommandParameter="{x:Static models:OrganizeMethod.ByType}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <Binding Path="SelectedMethod" Converter="{StaticResource MethodMatch}" ConverterParameter="ByType" />
                                            </DataTrigger.Binding>
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Extension" Margin="2,0"
                                Command="{Binding SetMethodCommand}"
                                CommandParameter="{x:Static models:OrganizeMethod.ByExtension}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <Binding Path="SelectedMethod" Converter="{StaticResource MethodMatch}" ConverterParameter="ByExtension" />
                                            </DataTrigger.Binding>
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Alphabet" Margin="2,0"
                                Command="{Binding SetMethodCommand}"
                                CommandParameter="{x:Static models:OrganizeMethod.ByAlphabet}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <Binding Path="SelectedMethod" Converter="{StaticResource MethodMatch}" ConverterParameter="ByAlphabet" />
                                            </DataTrigger.Binding>
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Size" Margin="2,0"
                                Command="{Binding SetMethodCommand}"
                                CommandParameter="{x:Static models:OrganizeMethod.BySize}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <Binding Path="SelectedMethod" Converter="{StaticResource MethodMatch}" ConverterParameter="BySize" />
                                            </DataTrigger.Binding>
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Date" Margin="2,0"
                                Command="{Binding SetMethodCommand}"
                                CommandParameter="{x:Static models:OrganizeMethod.ByDate}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <Binding Path="SelectedMethod" Converter="{StaticResource MethodMatch}" ConverterParameter="ByDate" />
                                            </DataTrigger.Binding>
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Photo" Margin="2,0"
                                Command="{Binding SetMethodCommand}"
                                CommandParameter="{x:Static models:OrganizeMethod.ByDateTaken}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <Binding Path="SelectedMethod" Converter="{StaticResource MethodMatch}" ConverterParameter="ByDateTaken" />
                                            </DataTrigger.Binding>
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Name" Margin="2,0"
                                Command="{Binding SetMethodCommand}"
                                CommandParameter="{x:Static models:OrganizeMethod.ByName}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <Binding Path="SelectedMethod" Converter="{StaticResource MethodMatch}" ConverterParameter="ByName" />
                                            </DataTrigger.Binding>
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Date granularity sub-panel (visible when Date or Photo selected) -->
                <Border Grid.Row="1" HorizontalAlignment="Center" Margin="0,2,0,2"
                        Visibility="{Binding ShowDatePanel, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Year" Margin="2,0"
                                Command="{Binding SetDateGranularityCommand}"
                                CommandParameter="{x:Static models:DateGranularity.Year}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Setter Property="Padding" Value="12,4" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDateGranularity}" Value="Year">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Month" Margin="2,0"
                                Command="{Binding SetDateGranularityCommand}"
                                CommandParameter="{x:Static models:DateGranularity.Month}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Setter Property="Padding" Value="12,4" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDateGranularity}" Value="Month">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Date" Margin="2,0"
                                Command="{Binding SetDateGranularityCommand}"
                                CommandParameter="{x:Static models:DateGranularity.Day}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Setter Property="Padding" Value="12,4" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedDateGranularity}" Value="Day">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Type count badge -->
                <Border Grid.Row="1" HorizontalAlignment="Center"
                        Background="{StaticResource TertiaryBackgroundBrush}"
                        CornerRadius="10" Padding="12,4" Margin="0,2,0,6"
                        Visibility="{Binding ShowDatePanel, Converter={StaticResource InvBoolToVis}}">
                    <TextBlock Text="{Binding TypeCountText}"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="12" FontWeight="SemiBold" />
                </Border>

                <!-- Donut Chart -->
                <controls:DonutChart Grid.Row="2"
                                     Items="{Binding CategoryStatsItems}"
                                     TotalText="{Binding TotalFiles}"
                                     SubText="TOTAL ITEMS"
                                     RulesActiveText="{Binding RulesActiveText}"
                                     Margin="20"
                                     MinHeight="200" />

                <!-- Checkboxes row -->
                <StackPanel Grid.Row="3" Orientation="Horizontal"
                            HorizontalAlignment="Center" Margin="0,4,0,8">
                    <CheckBox Style="{StaticResource ModernCheckBox}"
                              IsChecked="{Binding IncludeSubfolders}"
                              Content="subfolders" FontSize="11" Margin="0,0,12,0" />
                    <CheckBox Style="{StaticResource ModernCheckBox}"
                              IsChecked="{Binding ApplyFilters}"
                              Content="filters" FontSize="11" Margin="0,0,12,0" />
                    <CheckBox Style="{StaticResource ModernCheckBox}"
                              IsChecked="{Binding MoveMode}"
                              Content="move" FontSize="11" Margin="0,0,12,0" />
                    <CheckBox Style="{StaticResource ModernCheckBox}"
                              IsChecked="{Binding CopyMode}"
                              Content="copy" FontSize="11" Margin="0,0,12,0" />
                    <CheckBox Style="{StaticResource ModernCheckBox}"
                              IsChecked="{Binding SkipDuplicates}"
                              Content="skip dupes" FontSize="11"
                              ToolTip="Files with identical content: skipped in copy mode, moved to _duplicates in move mode (undoable)" />
                </StackPanel>

                <!-- Organize / Undo / History Buttons -->
                <Grid Grid.Row="4" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding OrganizeCommand}"
                            Padding="28,10" Margin="0,0,4,0">
                        <TextBlock Text="{Binding OrganizeButtonText}" FontSize="14" />
                    </Button>

                    <Button Grid.Column="1"
                            Command="{Binding UndoCommand}"
                            Padding="28,10" Margin="4,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Undo" FontSize="14" />
                    </Button>

                    <Button Grid.Column="2" x:Name="HistoryButton"
                            Command="{Binding ToggleHistoryCommand}"
                            Padding="16,10" Margin="4,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="History" FontSize="14" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- History Popup -->
                <Popup IsOpen="{Binding ShowHistory}"
                       PlacementTarget="{Binding ElementName=HistoryButton}"
                       Placement="Top" StaysOpen="False"
                       AllowsTransparency="True">
                    <Border Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="12" MinWidth="320" MaxHeight="400">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Organizing History"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Button Style="{StaticResource IconButton}"
                                        Command="{Binding ClearHistoryCommand}"
                                        Content="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                        FontSize="12" Padding="6" Margin="8,0,0,0"
                                        ToolTip="Clear History" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="240">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding HistoryItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource TertiaryBackgroundBrush}" />
                                                            <Setter Property="Opacity" Value="1" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUndone}" Value="True">
                                                                    <Setter Property="Opacity" Value="0.5" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Description}"
                                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                                       FontSize="12" TextWrapping="Wrap" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding Timestamp, Converter={StaticResource TimestampToRelative}}"
                                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                                           FontSize="11" />
                                                                <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                                                                           FontSize="11" Margin="8,0,0,0">
                                                                    <Run Text="{Binding Moves.Count, Mode=OneWay}" />
                                                                    <Run Text="files" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Command="{Binding PlacementTarget.DataContext.UndoOperationCommand, RelativeSource={RelativeSource AncestorType=Popup}}"
                                                                CommandParameter="{Binding}"
                                                                Content="&#xE7A7;" FontFamily="Segoe MDL2 Assets"
                                                                FontSize="14" Padding="6" Cursor="Hand"
                                                                VerticalAlignment="Center"
                                                                ToolTip="Undo this operation"
                                                                Background="Transparent" BorderThickness="0"
                                                                Foreground="{DynamicResource PrimaryTextBrush}">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsUndone}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="No history yet"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="12" FontStyle="Italic"
                                               HorizontalAlignment="Center" Margin="0,8">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HistoryItems.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Popup>

                <!-- Destination label -->
                <TextBlock Grid.Row="5"
                           HorizontalAlignment="Center"
                           FontSize="12" Margin="0,0,0,6"
                           Foreground="{StaticResource SecondaryTextBrush}">
                    <Run Text="Destination" />
                    <Run Text=" &#x2192; " />
                    <Run Text="{Binding DestinationDisplay, Mode=OneWay}" />
                </TextBlock>

                <!-- Category Legend / Stats (clickable to toggle) -->
                <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,0,0,4">
                <ItemsControl ItemsSource="{Binding CategoryStatsItems}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" Cursor="Hand"
                                    CornerRadius="4" Padding="4,2" Margin="0,1">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.ToggleCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding Name}" />
                                </Border.InputBindings>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource TertiaryBackgroundBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid MinWidth="140">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Opacity" Value="1.0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                                    <Setter Property="Opacity" Value="0.35" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <Border Grid.Column="0" Width="10" Height="10" CornerRadius="2"
                                            VerticalAlignment="Center"
                                            Background="{Binding Color, Converter={StaticResource ColorToBrush}}" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Name}"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Margin="6,0,12,0" />

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Count}"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ========== RIGHT PANEL: PREVIEW / VIEW ========== -->
            <Border Grid.Column="4" Style="{StaticResource Card}" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Destination (always visible, above toolbar) -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource SecondaryButton}"
                                Command="{Binding SelectDestinationCommand}"
                                Padding="6,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" VerticalAlignment="Center"
                                           Margin="0,0,4,0" Foreground="{StaticResource WarningBrush}" />
                                <TextBlock Text="DESTINATION" FontFamily="Segoe UI"
                                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="1" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding DestinationFolder}">
                            <Run Text="&#x2192;" />
                            <Run Text="{Binding DestinationDisplay, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>

                    <!-- View mode toolbar + expand/collapse -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,0,0,6">
                        <!-- Tree view -->
                        <Button Command="{Binding SetViewModeCommand}"
                                CommandParameter="{x:Static models:FileViewMode.Tree}"
                                ToolTip="Tree" Padding="8,5" Margin="2,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTreeView}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                        </Button>
                        <!-- Icons view -->
                        <Button Command="{Binding SetViewModeCommand}"
                                CommandParameter="{x:Static models:FileViewMode.Icons}"
                                ToolTip="Icons" Padding="8,5" Margin="2,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIconsView}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="&#xE80A;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                        </Button>
                        <!-- List view -->
                        <Button Command="{Binding SetViewModeCommand}"
                                CommandParameter="{x:Static models:FileViewMode.List}"
                                ToolTip="List" Padding="8,5" Margin="2,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsListView}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                        </Button>
                        <!-- Details view -->
                        <Button Command="{Binding SetViewModeCommand}"
                                CommandParameter="{x:Static models:FileViewMode.Details}"
                                ToolTip="Details" Padding="8,5" Margin="2,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDetailsView}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="&#xE179;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                        </Button>

                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="8,2" />

                        <!-- Expand all -->
                        <Button ToolTip="Expand All" Padding="8,5" Margin="2,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Setter Property="Command" Value="{Binding ExpandAllViewCommand}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTreeView}" Value="True">
                                            <Setter Property="Command" Value="{Binding ExpandAllPreviewCommand}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="&#xE740;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                        </Button>
                        <!-- Collapse all -->
                        <Button ToolTip="Collapse All" Padding="8,5" Margin="2,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Setter Property="Command" Value="{Binding CollapseAllViewCommand}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTreeView}" Value="True">
                                            <Setter Property="Command" Value="{Binding CollapseAllPreviewCommand}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="&#xE73F;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{StaticResource PrimaryTextBrush}" />
                        </Button>
                    </StackPanel>

                    <!-- TREE: Preview Tree View -->
                    <TreeView Grid.Row="2"
                              ItemsSource="{Binding PreviewItems}"
                              Style="{StaticResource ModernTreeView}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              Visibility="{Binding IsTreeView, Converter={StaticResource BoolToVis}}">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                                <Style.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource PrimaryTextColor}" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource PrimaryTextColor}" />
                                </Style.Resources>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="2,3">
                                    <TextBlock Text="{Binding IsFolder, Converter={StaticResource BoolToFolderIcon}}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="{Binding IsFolder, Converter={StaticResource BoolToColor}}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="{Binding IsFolder, Converter={StaticResource BoolToFontWeight}}"
                                               Foreground="{StaticResource PrimaryTextBrush}"
                                               VerticalAlignment="Center"
                                               FontSize="13" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <!-- VIEW: flat virtualized list (Icons/List/Details) -->
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding FlatViewItems}"
                             Visibility="{Binding IsNonTreeView, Converter={StaticResource BoolToVis}}"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Background="Transparent" BorderThickness="0"
                             SelectionMode="Single"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ContentControl>
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <!-- Default: LIST view (for file items) -->
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ContentControl">
                                                        <Border Background="Transparent" Cursor="Hand"
                                                                CornerRadius="4" Padding="6,4" Margin="0,0,0,1">
                                                            <Border.InputBindings>
                                                                <MouseBinding MouseAction="LeftDoubleClick"
                                                                              Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                              CommandParameter="{Binding FullPath}" />
                                                            </Border.InputBindings>
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="{StaticResource TertiaryBackgroundBrush}" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Image Grid.Column="0" Width="20" Height="20" Stretch="UniformToFill"
                                                                       Source="{Binding Thumbnail}"
                                                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                                       Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}" />
                                                                <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                                                           FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                                           Foreground="{StaticResource AccentBrush}"
                                                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                                                           Visibility="{Binding HasThumbnail, Converter={StaticResource InvBoolToVis}}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding FileName}"
                                                                           FontSize="12" Foreground="{StaticResource PrimaryTextBrush}"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <!-- HEADER item -->
                                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ContentControl">
                                                                <Border Background="Transparent" Cursor="Hand"
                                                                        Padding="4,8,4,4" Margin="0,2,0,0">
                                                                    <Border.InputBindings>
                                                                        <MouseBinding MouseAction="LeftClick"
                                                                                      Command="{Binding DataContext.ToggleViewGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                      CommandParameter="{Binding Group}" />
                                                                    </Border.InputBindings>
                                                                    <StackPanel>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="{Binding Icon}"
                                                                                       FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                                                       Foreground="{StaticResource AccentBrush}"
                                                                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                            <TextBlock Text="{Binding HeaderText}"
                                                                                       FontSize="13" FontWeight="SemiBold"
                                                                                       Foreground="{StaticResource AccentBrush}" />
                                                                        </StackPanel>
                                                                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,4,0,0" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <!-- ICONS view override (non-header) -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsHeader}" Value="False" />
                                                        <Condition Binding="{Binding DataContext.IsIconsView, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ContentControl">
                                                                <Border Background="Transparent" Cursor="Hand"
                                                                        CornerRadius="6" Padding="4" Margin="2"
                                                                        ToolTip="{Binding FileName}">
                                                                    <Border.InputBindings>
                                                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                                                      Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                      CommandParameter="{Binding FullPath}" />
                                                                    </Border.InputBindings>
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Background" Value="{StaticResource TertiaryBackgroundBrush}" />
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Image Grid.Column="0" Width="48" Height="48" Stretch="UniformToFill"
                                                                               Source="{Binding Thumbnail}"
                                                                               VerticalAlignment="Center" Margin="0,2,10,2"
                                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                                               Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}" />
                                                                        <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                                                                   FontFamily="Segoe MDL2 Assets" FontSize="28"
                                                                                   Foreground="{StaticResource AccentBrush}"
                                                                                   VerticalAlignment="Center" Margin="0,2,10,2"
                                                                                   Visibility="{Binding HasThumbnail, Converter={StaticResource InvBoolToVis}}" />
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding FileName}" FontSize="12"
                                                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                                                       TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock FontSize="10" Foreground="{StaticResource SecondaryTextBrush}">
                                                                                <Run Text="{Binding SizeText, Mode=OneWay}" />
                                                                                <Run Text="  " />
                                                                                <Run Text="{Binding Extension, Mode=OneWay}" />
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </MultiDataTrigger>
                                                <!-- DETAILS view override (non-header) -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsHeader}" Value="False" />
                                                        <Condition Binding="{Binding DataContext.IsDetailsView, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ContentControl">
                                                                <Border Background="Transparent" Cursor="Hand" Padding="2,3">
                                                                    <Border.InputBindings>
                                                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                                                      Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                      CommandParameter="{Binding FullPath}" />
                                                                    </Border.InputBindings>
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Background" Value="{StaticResource TertiaryBackgroundBrush}" />
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="28" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="70" />
                                                                            <ColumnDefinition Width="100" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Image Grid.Column="0" Width="18" Height="18" Stretch="UniformToFill"
                                                                               Source="{Binding Thumbnail}"
                                                                               VerticalAlignment="Center" Margin="2,0,0,0"
                                                                               Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}" />
                                                                        <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                                                                   FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                                                   Foreground="{StaticResource AccentBrush}"
                                                                                   VerticalAlignment="Center" Margin="2,0,0,0"
                                                                                   Visibility="{Binding HasThumbnail, Converter={StaticResource InvBoolToVis}}" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="11"
                                                                                   Foreground="{StaticResource PrimaryTextBrush}"
                                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="10"
                                                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                                                   VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Column="3" Text="{Binding DateText}" FontSize="10"
                                                                                   Foreground="{StaticResource SecondaryTextBrush}"
                                                                                   VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </Grid>
            </Border>
        </Grid>

        <!-- ==================== STATUS BAR ==================== -->
        <Border Grid.Row="2"
                Background="{StaticResource SecondaryBackgroundBrush}"
                Padding="20,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           VerticalAlignment="Center" />

                <ProgressBar Grid.Column="1"
                             Style="{StaticResource ModernProgressBar}"
                             Value="{Binding Progress}"
                             Maximum="100"
                             VerticalAlignment="Center"
                             Margin="16,0"
                             Visibility="{Binding IsOrganizing, Converter={StaticResource BoolToVis}}" />

                <TextBlock Grid.Column="2"
                           Text="{Binding SourceFolder}"
                           FontSize="11"
                           Foreground="{StaticResource BorderBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="300" />
            </Grid>
        </Border>
    </Grid>
</Window>
